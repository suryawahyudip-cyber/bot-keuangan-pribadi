# Salin file ini jadi ".env" (tanpa .example) lalu isi dengan nilai asli kamu.
# File ".env" JANGAN pernah diupload ke GitHub (sudah otomatis diabaikan lewat .gitignore).

TELEGRAM_TOKEN=paste_token_bot_kamu_di_sini

SHEET_ID=paste_sheet_id_kamu_di_sini

# Buka credentials.json pakai text editor, copy SEMUA isinya (termasuk { dan } di awal/akhir),
# lalu paste di antara tanda kutip satu (') di bawah ini - boleh multi-baris seperti aslinya.
GOOGLE_CREDENTIALS_JSON='paste_seluruh_isi_credentials.json_di_sini'

# Opsional - tanpa ini bot tetap jalan, hanya pakai format kaku (tanpa pemahaman bahasa natural).
# Dapatkan di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=paste_api_key_gemini_kamu_di_sini

# Telegram ID pemilik bot. WAJIB diisi - bot hanya melayani ID ini dan menolak semua orang lain.
# Cara tahu ID kamu: jalankan bot, lalu kirim perintah /id ke bot.
ALLOWED_USER_ID=paste_telegram_id_kamu_di_sini

# Opsional - batas pengeluaran harian dalam Rupiah (default 50000).
# Bot memberi peringatan kalau total pengeluaran hari itu melewatinya.
BATAS_HARIAN=50000
